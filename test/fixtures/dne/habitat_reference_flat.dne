// File created by BayesianNetworkFormats.jl

bnet habitat_reference {
autoupdate = TRUE;
comment = "SPEC section 45 reference ecological Bayesian network.";

visual V1 {
	defdispform = BELIEFBARS;
	nodelabeling = NAMETITLE;
	};

node Climate {
	kind = NATURE;
	discrete = TRUE;
	chance = CHANCE;
	states = (dry, normal, wet);
	parents = ();
	probs = 
		// dry     normal  wet
		  (0.3,    0.5,    0.2);
	comment = "Regional climate regime.";
	visual V1 {
		center = (100, 60);
		};
	};
node Irrigation {
	kind = NATURE;
	discrete = TRUE;
	chance = CHANCE;
	states = (low, high);
	parents = ();
	probs = 
		// low   high
		  (0.6,  0.4);
	visual V1 {
		center = (300, 60);
		};
	};
node SoilMoisture {
	kind = NATURE;
	discrete = TRUE;
	chance = CHANCE;
	states = (low, medium, high);
	parents = (Climate, Irrigation);
	probs = 
		// low     medium  high     // Climate Irrigation
		   (0.7,    0.25,   0.05,       // dry     low
		    0.3,    0.5,    0.2,        // dry     high
		    0.3,    0.5,    0.2,        // normal  low
		    0.1,    0.4,    0.5,        // normal  high
		    0.1,    0.4,    0.5,        // wet     low
		    0.05,   0.25,   0.7);       // wet     high
	title = "Soil moisture";
	visual V1 {
		center = (200, 150);
		};
	};
node GrazingPressure {
	kind = NATURE;
	discrete = TRUE;
	chance = CHANCE;
	states = (low, high);
	parents = ();
	probs = 
		// low   high
		  (0.5,  0.5);
	title = "Grazing pressure";
	visual V1 {
		center = (400, 150);
		};
	};
node Vegetation {
	kind = NATURE;
	discrete = TRUE;
	chance = CHANCE;
	states = (sparse, moderate, dense);
	parents = (SoilMoisture, GrazingPressure);
	probs = 
		// sparse    moderate  dense      // SoilMoisture GrazingPressure
		   (0.6,      0.3,      0.1,          // low          low
		    0.8,      0.15,     0.05,         // low          high
		    0.2,      0.5,      0.3,          // medium       low
		    0.4,      0.45,     0.15,         // medium       high
		    0.05,     0.3,      0.65,         // high         low
		    0.2,      0.5,      0.3);         // high         high
	visual V1 {
		center = (300, 240);
		};
	};
node HabitatQuality {
	kind = NATURE;
	discrete = TRUE;
	chance = CHANCE;
	states = (poor, good);
	parents = (Vegetation);
	probs = 
		// poor  good   // Vegetation
		  (0.85, 0.15,     // sparse
		   0.4,  0.6,      // moderate
		   0.15, 0.85);    // dense
	title = "Habitat quality";
	visual V1 {
		center = (300, 330);
		};
	};
node Occupancy {
	kind = NATURE;
	discrete = TRUE;
	chance = CHANCE;
	states = (absent, present);
	parents = (HabitatQuality);
	probs = 
		// absent   present   // HabitatQuality
		  (0.8,     0.2,         // poor
		   0.25,    0.75);       // good
	visual V1 {
		center = (300, 420);
		};
	};
};
