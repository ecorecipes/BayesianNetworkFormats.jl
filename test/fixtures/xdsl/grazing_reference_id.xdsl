<?xml version="1.0" encoding="UTF-8"?>
<smile version="1.0" id="grazing_reference_id" numsamples="10000">
  <nodes>
    <cpt id="Climate">
      <state id="dry"/>
      <state id="normal"/>
      <state id="wet"/>
      <probabilities>0.3 0.5 0.2</probabilities>
    </cpt>
    <cpt id="ClimateForecast">
      <state id="dry"/>
      <state id="normal"/>
      <state id="wet"/>
      <parents>Climate</parents>
      <probabilities>0.7 0.2 0.1 0.15 0.7 0.15 0.1 0.2 0.7</probabilities>
    </cpt>
    <cpt id="SoilMoisture">
      <state id="low"/>
      <state id="medium"/>
      <state id="high"/>
      <parents>Climate</parents>
      <probabilities>0.7 0.25 0.05 0.3 0.5 0.2 0.05 0.3 0.65</probabilities>
    </cpt>
    <cpt id="CurrentVegetation">
      <state id="sparse"/>
      <state id="moderate"/>
      <state id="dense"/>
      <probabilities>0.3 0.4 0.3</probabilities>
    </cpt>
    <decision id="GrazingManagement">
      <state id="exclude"/>
      <state id="reduce"/>
      <state id="maintain"/>
      <parents>ClimateForecast CurrentVegetation</parents>
    </decision>
    <cpt id="GrazingPressure">
      <state id="low"/>
      <state id="high"/>
      <parents>GrazingManagement</parents>
      <probabilities>0.95 0.05 0.6 0.4 0.15 0.85</probabilities>
    </cpt>
    <cpt id="Vegetation">
      <state id="sparse"/>
      <state id="moderate"/>
      <state id="dense"/>
      <parents>SoilMoisture GrazingPressure CurrentVegetation</parents>
      <probabilities>0.5 0.35 0.15 0.3 0.4 0.3 0.15 0.35 0.5 0.85 0.12 0.03 0.7 0.25 0.05 0.5 0.35 0.15 0.3 0.4 0.3 0.15 0.35 0.5 0.05 0.25 0.7 0.7 0.25 0.05 0.5 0.35 0.15 0.3 0.4 0.3 0.15 0.35 0.5 0.05 0.25 0.7 0.03 0.12 0.85 0.5 0.35 0.15 0.3 0.4 0.3 0.15 0.35 0.5</probabilities>
    </cpt>
    <cpt id="HabitatQuality">
      <state id="poor"/>
      <state id="good"/>
      <parents>Vegetation</parents>
      <probabilities>0.85 0.15 0.4 0.6 0.15 0.85</probabilities>
    </cpt>
    <cpt id="Occupancy">
      <state id="absent"/>
      <state id="present"/>
      <parents>HabitatQuality</parents>
      <probabilities>0.8 0.2 0.25 0.75</probabilities>
    </cpt>
    <cpt id="Biodiversity">
      <state id="low"/>
      <state id="high"/>
      <parents>Occupancy</parents>
      <probabilities>0.9 0.1 0.3 0.7</probabilities>
    </cpt>
    <utility id="ConservationBenefit">
      <parents>Biodiversity</parents>
      <utilities>0.0 100.0</utilities>
    </utility>
    <utility id="ManagementCost">
      <parents>GrazingManagement</parents>
      <utilities>-40.0 -15.0 0.0</utilities>
    </utility>
    <mau id="TotalUtility">
      <parents>ConservationBenefit ManagementCost</parents>
      <weights>1.0 1.0</weights>
    </mau>
  </nodes>
  <extensions>
    <genie version="1.0" app="BayesianNetworkFormats.jl" name="grazing_reference_id">
      <node id="Climate">
        <name>Climate</name>
        <position>60 40 140 80</position>
      </node>
      <node id="ClimateForecast">
