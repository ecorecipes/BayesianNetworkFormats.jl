<?xml version="1.0" encoding="UTF-8"?>
<smile version="1.0" id="habitat_reference" numsamples="10000">
  <nodes>
    <cpt id="Climate">
      <state id="dry"/>
      <state id="normal"/>
      <state id="wet"/>
      <probabilities>0.3 0.5 0.2</probabilities>
    </cpt>
    <cpt id="Irrigation">
      <state id="low"/>
      <state id="high"/>
      <probabilities>0.6 0.4</probabilities>
    </cpt>
    <cpt id="SoilMoisture">
      <state id="low"/>
      <state id="medium"/>
      <state id="high"/>
      <parents>Climate Irrigation</parents>
      <probabilities>0.7 0.25 0.05 0.3 0.5 0.2 0.3 0.5 0.2 0.1 0.4 0.5 0.1 0.4 0.5 0.05 0.25 0.7</probabilities>
    </cpt>
    <cpt id="GrazingPressure">
      <state id="low"/>
      <state id="high"/>
      <probabilities>0.5 0.5</probabilities>
    </cpt>
    <cpt id="Vegetation">
      <state id="sparse"/>
      <state id="moderate"/>
      <state id="dense"/>
      <parents>SoilMoisture GrazingPressure</parents>
      <probabilities>0.6 0.3 0.1 0.8 0.15 0.05 0.2 0.5 0.3 0.4 0.45 0.15 0.05 0.3 0.65 0.2 0.5 0.3</probabilities>
    </cpt>
    <cpt id="HabitatQuality">
      <state id="poor"/>
      <state id="good"/>
      <parents>Vegetation</parents>
      <probabilities>0.85 0.15 0.4 0.6 0.15 0.85</probabilities>
    </cpt>
    <cpt id="Occupancy">
      <state id="absent"/>
      <state id="present"/>
      <parents>HabitatQuality</parents>
      <probabilities>0.8 0.2 0.25 0.75</probabilities>
    </cpt>
  </nodes>
  <extensions>
    <genie version="1.0" app="BayesianNetworkFormats.jl" name="habitat_reference">
      <node id="Climate">
        <name>Climate</name>
        <position>60 40 140 80</position>
        <comment>Regional climate regime.</comment>
      </node>
      <node id="Irrigation">
        <name>Irrigation</name>
        <position>260 40 340 80</position>
      </node>
      <node id="SoilMoisture">
        <name>Soil moisture</name>
        <position>160 130 240 170</position>
      </node>
      <node id="GrazingPressure">
